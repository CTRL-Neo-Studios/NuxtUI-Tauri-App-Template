		"lint": "eslint .",
		"lint:fix": "eslint --fix ."
	},
	"dependencies": {
		"@iconify-json/lucide": "^1.2.34",
		"@iconify-json/simple-icons": "^1.2.30",
		"@nuxt/fonts": "0.11.1",
		"@nuxt/icon": "1.11.0",
		"@nuxt/image": "1.10.0",
		"@nuxt/ui": "3.0.2",
		"@nuxtjs/i18n": "9.5.2",
		"@vueuse/nuxt": "13.0.0",
		"nuxt": "^3.16.2",
		"nuxt-auth-utils": "0.5.18",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.4.1",
		"eslint": "^9.24.0",
		"typescript": "^5.8.3"
	},
	"packageManager": "pnpm@10.7.1"
