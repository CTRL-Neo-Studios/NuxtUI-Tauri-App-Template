		"@nuxtjs/i18n": "10.2.0",
		"@vueuse/nuxt": "14.0.0",
		"nuxt": "^4.2.1",
		"nuxt-auth-utils": "0.5.25",
		"vue": "^3.5.24"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.9.4",
