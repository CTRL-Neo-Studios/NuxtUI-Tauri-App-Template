{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"tauri": "cd src-tauri && tauri",
		"tauri:dev": "cd src-tauri && pnpm tauri dev",
		"tauri:build": "cd src-tauri && pnpm i && pnpm tauri build",
